# ============================================================================
# BYBIT SCALPER BOT - Environment Configuration
# ============================================================================
# IMPORTANT: Rename this file to .env and fill in your credentials
# ============================================================================

# ----------------------------------------------------------------------------
# TRADING MODE
# ----------------------------------------------------------------------------
# Options: "paper" or "live"
# - paper: Uses real mainnet prices but simulates trades (no real money)
# - live: Real trading with real money (BE CAREFUL!)
TRADING_MODE=paper

# ----------------------------------------------------------------------------
# BYBIT API CREDENTIALS
# ----------------------------------------------------------------------------
# Get your API keys from: https://www.bybit.com/app/user/api-management
#
# SECURITY TIPS:
# - Create separate API keys for paper and live trading
# - For live trading, enable IP whitelist
# - Set trade permissions only (no withdrawal!)
# - Use subaccount for bot trading
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Bybit API endpoint
# Mainnet: https://api.bybit.com
# Testnet: https://api-testnet.bybit.com (NOT RECOMMENDED - buggy)
BYBIT_API_URL=https://api.bybit.com

# ----------------------------------------------------------------------------
# TELEGRAM BOT CONFIGURATION
# ----------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram
# 1. Talk to @BotFather
# 2. Send /newbot
# 3. Follow instructions
# 4. Copy the token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram user ID (to restrict bot access)
# Get it from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_telegram_user_id_here

# Enable Telegram notifications
TELEGRAM_ENABLED=true

# ----------------------------------------------------------------------------
# TRADING CONFIGURATION
# ----------------------------------------------------------------------------
# Trading pair
SYMBOL=BTCUSDT

# Timeframe for candles (15m recommended for scalping)
TIMEFRAME=15

# Path to trading configuration YAML
CONFIG_PATH=config_ultra_optimized_FINAL.yaml

# Path to ML model
MODEL_PATH=storage/models/ultra_scalper_btcusdt_365d.pkl

# ----------------------------------------------------------------------------
# RISK MANAGEMENT
# ----------------------------------------------------------------------------
# Maximum position size in USD
MAX_POSITION_SIZE_USD=1000.0

# Maximum number of concurrent positions (1 recommended for scalper)
MAX_CONCURRENT_POSITIONS=1

# Stop trading if daily loss exceeds this percentage
DAILY_LOSS_LIMIT_PCT=5.0

# Stop trading if total loss exceeds this amount in USD
TOTAL_LOSS_LIMIT_USD=500.0

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/trading_bot.log

# Save trades to CSV
SAVE_TRADES_CSV=true
TRADES_CSV_PATH=logs/trades.csv

# ----------------------------------------------------------------------------
# PAPER TRADING SIMULATION
# ----------------------------------------------------------------------------
# Initial balance for paper trading (USD)
PAPER_INITIAL_BALANCE=10000.0

# Slippage simulation in percentage (0.05 = 0.05%)
PAPER_SLIPPAGE_PCT=0.05

# Commission/fee in percentage (Bybit: 0.055% taker)
PAPER_FEE_PCT=0.055

# ----------------------------------------------------------------------------
# ADVANCED SETTINGS
# ----------------------------------------------------------------------------
# Check for new signals every N seconds (recommended: 60-300)
CHECK_INTERVAL_SECONDS=60

# Retry failed API calls
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY_SECONDS=5

# Timezone for logs (America/Sao_Paulo, UTC, etc.)
TIMEZONE=America/Sao_Paulo

# Enable debug mode (more verbose logging)
DEBUG_MODE=false

# ----------------------------------------------------------------------------
# SAFETY CHECKS
# ----------------------------------------------------------------------------
# Require confirmation before opening trades (live mode only)
REQUIRE_CONFIRMATION=true

# Maximum trades per day (safety limit)
MAX_TRADES_PER_DAY=20

# Minimum time between trades in minutes
MIN_TIME_BETWEEN_TRADES_MINUTES=15

# Enable circuit breaker (stop trading after consecutive losses)
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_CONSECUTIVE_LOSSES=5

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
